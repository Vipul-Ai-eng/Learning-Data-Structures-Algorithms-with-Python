   "source": [
    "def insertionSort(a):\n",
    "    n = len(a)\n",
    "    for i in range(1,n):\n",
    "        key = a[i]\n",
    "        j = i-1\n",
    "        while( j >= 0 and key < a[j]):\n",
    "            a[j+1] = a[j]\n",
    "            j = j-1\n",
    "\n",
    "        a[j+1] = key\n",
    "a = [64, 32, 25, 45, 40, 51, 2]\n",
    "insertionSort(a)\n",
    "print(a)"
   ]
  },
